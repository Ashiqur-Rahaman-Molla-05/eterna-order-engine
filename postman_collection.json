            }
          ]
        },
        "description": "Get detailed information about a specific order by its ID"
      },
      "response": []
    },
    {
      "name": "Get User Order History",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/orders?userId=user123&limit=50",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders"],
          "query": [
            {
              "key": "userId",
              "value": "user123",
              "description": "User identifier"
            },
            {
              "key": "limit",
              "value": "50",
              "description": "Maximum number of orders to return"
            }
          ]
        },
        "description": "Retrieve order history for a specific user"
      },
      "response": []
    },
    {
