          "path": ["health"]
        },
        "description": "Check if the server is running and healthy"
      },
      "response": []
    },
    {
      "name": "Submit Market Order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"user123\",\n  \"orderType\": \"market\",\n  \"tokenIn\": \"SOL\",\n  \"tokenOut\": \"USDC\",\n  \"amountIn\": 100,\n  \"slippage\": 0.01\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders/submit",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders", "submit"]
        },
        "description": "Submit a market order for execution. Returns orderId and WebSocket URL for status updates."
      },
      "response": []
    },
